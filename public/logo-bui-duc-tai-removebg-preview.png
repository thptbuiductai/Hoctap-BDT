    <linearGradient id="flame-inner-glow" x1="250" y1="120" x2="250" y2="200" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#FFF176" stop-opacity="0.9" />
      <stop offset="100%" stop-color="#FF9800" stop-opacity="0.4" />
    </linearGradient>
    <radialGradient id="torch-glow" cx="250" cy="170" r="80" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#FFE082" stop-opacity="0.75" />
      <stop offset="65%" stop-color="#FFE082" stop-opacity="0.25" />
      <stop offset="100%" stop-color="#48C3FC" stop-opacity="0" />
